{
  "schema_version": "search-quality-policy/v1",
  "id": "example-non-production",
  "version": "illustrative-only-v1",
  "requirements": {
    "complete": true,
    "catalog_revision": "example-catalog-revision",
    "allowed_pipelines": [
      "lexical",
      "lexical_reranked"
    ],
    "degraded_responses": 0
  },
  "assertions": [
    {
      "id": "example-overall-recall",
      "scope": "overall",
      "metric": "recall",
      "cutoff": 10,
      "operator": "gte",
      "value": 0.8
    },
    {
      "id": "example-overall-zero-result-rate",
      "scope": "overall",
      "metric": "zero_result_rate",
      "operator": "lte",
      "value": 0.1
    },
    {
      "id": "example-overall-latency",
      "scope": "overall",
      "metric": "latency_ms",
      "quantile": 0.95,
      "operator": "lte",
      "value": 250
    },
    {
      "id": "example-service-ndcg",
      "scope": "slice",
      "slice": "intent:service",
      "metric": "ndcg",
      "cutoff": 10,
      "operator": "gte",
      "value": 0.7
    }
  ]
}
